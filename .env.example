# Copy to .env.local for local development. Never commit real values.
ANTHROPIC_API_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Optional: pins accepted photo URLs to this store (otherwise read from the token)
BLOB_STORE_ID=
# Owner-only secret for admin operations
ADMIN_SECRET=

# Hero Forge (all optional in development: fakes run when a key is missing; production refuses fakes)
PUBLIC_BASE_URL=
# Email sign-in (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Payments (Stripe): secret, webhook secret and one price ID per credit pack
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SMALL=
STRIPE_PRICE_MEDIUM=
STRIPE_PRICE_LARGE=
# Generation providers
TRIPO_API_KEY=
FORGE_LLM_BASE_URL=
FORGE_LLM_API_KEY=
FORGE_LLM_MODEL=
FORGE_IMAGE_BASE_URL=
FORGE_IMAGE_API_KEY=
FORGE_IMAGE_MODEL=
# Optional provider order overrides, e.g. FORGE_PROVIDERS_DIRECTOR=anthropic,openai-compatible
FORGE_PROVIDERS_DIRECTOR=
# Set to 1 to force fake providers outside production
FORGE_FAKE_PROVIDERS=
