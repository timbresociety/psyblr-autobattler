{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{db/schema.sql,public/heroes/m-medium.glb,public/heroes/m-medium.kit.json,public/kit/wear/beanie.glb,public/kit/wear/tee.glb,public/kit/wear/trousers.glb,public/kit/wear/kimono.glb,public/kit/wear/cape.glb,public/kit/wear/sneakers.glb}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/router?__route=:route*"
    }
  ]
}
