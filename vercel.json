{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "db/schema.sql",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/router?__route=:route*"
    }
  ]
}
